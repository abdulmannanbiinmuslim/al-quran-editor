# .env.example

# Firebase Configuration
FIREBASE_PROJECT_ID=al-quran-editor
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=al-quran-editor.firebaseapp.com
FIREBASE_STORAGE_BUCKET=al-quran-editor.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Gemini API (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# API Configuration
API_BASE_URL=https://api.alquran.cloud/v1
AUDIO_BASE_URL=https://everyayah.com/data

# App Configuration
APP_NAME=Al Quran Editor
APP_VERSION=1.0.0
BUILD_NUMBER=1

# Feature Flags
ENABLE_CLOUD_SYNC=true
ENABLE_AUDIO_DOWNLOAD=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true
